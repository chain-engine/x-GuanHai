{
  "info": {
    "name": "观海（GuanHai）",
    "description": "支持 HTTP 与 MCP 双挂载的 RAG 一体化工程框架。\n\n鉴权方式：AppId + GuanHai-1 HMAC 签名（签名逻辑与服务端 src/core/signature.py 严格对齐）。\n\n前提：在集合变量中配置 appId / appKey；健康检查、版本信息、系统状态接口无需鉴权。\n\n调试：每次发送请求会在 Postman Console（底部 Console 面板，快捷键 Ctrl+Alt+C）打印完整签名过程与实际请求头。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "apiPrefix",
      "value": "api/v1",
      "type": "string",
      "description": "API 前缀（不以 / 开头，拼接模板为 {{baseUrl}}/{{apiPrefix}}）"
    },
    {
      "key": "appId",
      "value": "app",
      "type": "string",
      "description": "开放 API 应用 AppId（默认种子应用为 app）"
    },
    {
      "key": "appKey",
      "value": "gk_admin_change_me",
      "type": "string",
      "description": "开放 API 应用 AppKey（默认种子应用凭据，生产环境请立即重置）"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// GuanHai-1 签名认证（AppId + HMAC-SHA256）",
          "// 前提：集合变量中已配置 appId 和 appKey",
          "// 每次请求会在 Postman Console（Ctrl+Alt+C）打印完整签名过程",
          "const appId = pm.collectionVariables.get(\"appId\");",
          "const appKey = pm.collectionVariables.get(\"appKey\");",
          "if (!appId || !appKey) {",
          "    console.warn(\"[GuanHai-1] 未配置 appId/appKey，跳过签名\");",
          "    return;",
          "}",
          "",
          "// 公开接口（健康检查/版本/状态）无需签名",
          "const resolvedPath = pm.variables.replaceIn(pm.request.url.getPath());",
          "const publicPaths = [\"/api/v1/health\", \"/api/v1/version\", \"/api/v1/status\"];",
          "if (publicPaths.some(p => resolvedPath.startsWith(p))) {",
          "    console.info(\"[GuanHai-1] 公开接口无需签名:\", resolvedPath);",
          "    return;",
          "}",
          "",
          "// 签名串 = GuanHai-1 + METHOD + URI + Content-Type + Date + SHA256(body)",
          "const method = pm.request.method;",
          "const fullUrl = pm.variables.replaceIn(pm.request.url.toString());",
          "const queryStr = pm.variables.replaceIn(pm.request.url.getQueryString() || \"\");",
          "const uri = resolvedPath + (queryStr ? \"?\" + queryStr : \"\");",
          "const contentType = \"application/json\";",
          "const date = new Date().toUTCString();",
          "",
          "// body SHA256（仅 raw JSON 模式可计算；formdata 不参与签名）",
          "let bodyText = \"\";",
          "let bodyHash = \"\";",
          "if (pm.request.body && pm.request.body.mode === \"raw\") {",
          "    bodyText = pm.request.body.raw || \"\";",
          "    bodyHash = bodyText ? CryptoJS.SHA256(bodyText).toString(CryptoJS.enc.Hex) : \"\";",
          "}",
          "",
          "const signingString = \"GuanHai-1\" + method + uri + contentType + date + bodyHash;",
          "const signature = CryptoJS.HmacSHA256(signingString, appKey).toString(CryptoJS.enc.Hex);",
          "",
          "// 设置请求头（formdata 请求保留原有 multipart Content-Type）",
          "pm.request.headers.upsert({ key: \"X-App-Id\", value: appId });",
          "pm.request.headers.upsert({ key: \"X-App-Date\", value: date });",
          "pm.request.headers.upsert({ key: \"X-App-Authorization\", value: \"GuanHai-1 \" + appId + \":\" + signature });",
          "if (!pm.request.body || pm.request.body.mode !== \"formdata\") {",
          "    pm.request.headers.upsert({ key: \"Content-Type\", value: \"application/json\" });",
          "}",
          "",
          "// 在 Console 打印签名过程（各项与服务端 build_signing_string 同源，可逐项比对）",
          "let bodyDisplay = \"(无 body)\";",
          "if (bodyText !== \"\") {",
          "    bodyDisplay = bodyText.length > 200 ? bodyText.slice(0, 200) + \" ...(截断)\" : bodyText;",
          "}",
          "const hashDisplay = bodyHash === \"\" ? \"(空 body，摘要为空串)\" : bodyHash;",
          "const out = [",
          "    \"================= GuanHai-1 签名过程 =================\",",
          "    \"[1] 请求方法      : \" + method,",
          "    \"[2] 完整URL       : \" + fullUrl,",
          "    \"[3] 签名URI       : \" + uri,",
          "    \"[4] X-App-Date    : \" + date,",
          "    \"[5] body 原文     : \" + bodyDisplay,",
          "    \"[6] SHA256(body)  : \" + hashDisplay,",
          "    \"[7] 签名串        : \" + signingString,",
          "    \"[8] 签名值        : \" + signature,",
          "    \"[9] 实际请求头    :\",",
          "    \"    X-App-Id            : \" + appId,",
          "    \"    X-App-Date          : \" + date,",
          "    \"    X-App-Authorization : GuanHai-1 \" + appId + \":\" + signature",
          "];",
          "if (pm.request.body && pm.request.body.mode === \"formdata\") {",
          "    out.push(\"注意: formdata 请求无法在 Pre-request Script 中复现 multipart body 摘要，签名值可能与服务端不一致，建议改用 examples/openapi_client.py\");",
          "}",
          "out.push(\"=====================================================\");",
          "console.log(out.join(\"\\n\"));"
        ]
      }
    }
  ],
